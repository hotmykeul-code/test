# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# 1. TikTok for Developers API credentials
# Create an app at https://developers.tiktok.com/
# Authorized Redirect URIs:
# Development: https://ais-dev-kr6wuqlyz7sy5hfkd5xfq3-512014020331.europe-west3.run.app/auth/tiktok/callback
# Shared: https://ais-pre-kr6wuqlyz7sy5hfkd5xfq3-512014020331.europe-west3.run.app/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# 2. Instagram & Meta Graph API credentials
# Create an app at https://developers.facebook.com/
# Authorized Redirect URIs:
# Development: https://ais-dev-kr6wuqlyz7sy5hfkd5xfq3-512014020331.europe-west3.run.app/auth/instagram/callback
# Shared: https://ais-pre-kr6wuqlyz7sy5hfkd5xfq3-512014020331.europe-west3.run.app/auth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# 3. Google & YouTube Shorts OAuth 2.0 credentials
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized Redirect URIs:
# Development: https://ais-dev-kr6wuqlyz7sy5hfkd5xfq3-512014020331.europe-west3.run.app/auth/google/callback
# Shared: https://ais-pre-kr6wuqlyz7sy5hfkd5xfq3-512014020331.europe-west3.run.app/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
